{
  "$defs": {
    "Attention": {
      "description": "A job that needs action, identified by kind and name.",
      "properties": {
        "degraded": {
          "const": true,
          "description": "Three or more committed collections in a row reported missing parts; `degraded` gives counts."
        },
        "failed": { "const": true },
        "freshness": { "type": "string" },
        "kind": { "enum": ["job"] },
        "name": { "type": "string" },
        "silent": { "const": true, "description": "Gained no new or changed record within `silent_after`." }
      },
      "required": ["kind", "name", "freshness"],
      "type": "object"
    },
    "Job": {
      "description": "A configured job's schedule, execution state and latest run outcome.",
      "properties": {
        "action": { "description": "The latest action the job wrote.", "type": "string" },
        "added": { "minimum": 0, "type": "integer" },
        "degraded": {
          "description": "The source's last committed collection reported that it missed `missed` of the `of` parts it tried, such as feeds or accounts, and `runs` committed collections in a row did: its records may lack what those parts hold. A complete collection clears it.",
          "properties": {
            "missed": { "minimum": 1, "type": "integer" },
            "of": { "minimum": 1, "type": "integer" },
            "runs": { "minimum": 1, "type": "integer" }
          },
          "required": ["runs", "missed", "of"],
          "type": "object"
        },
        "emit": { "enum": ["records", "messages", "message", "action", "log"] },
        "enabled": { "type": "boolean" },
        "error": { "description": "The last attempt's diagnostic; it never quotes provider output.", "type": "string" },
        "expired": { "minimum": 0, "type": "integer" },
        "failed": { "const": true },
        "failures": { "description": "Consecutive failed attempts.", "minimum": 0, "type": "integer" },
        "forgotten": { "minimum": 0, "type": "integer" },
        "freshness": { "enum": ["fresh", "overdue", "never", "manual", "unknown"] },
        "last_collected": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        },
        "last_reconcile": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        },
        "last_run": { "$ref": "#/$defs/Run" },
        "last_success": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        },
        "log": { "description": "The job's log in the brain, such as logs/NAME.log.", "type": "string" },
        "missed": { "minimum": 0, "type": "integer" },
        "mode": { "enum": ["window", "cursor", "snapshot"] },
        "next_due": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        },
        "priority": { "enum": ["normal", "low"] },
        "reconciled": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        },
        "record": { "description": "The record its latest run wrote.", "type": "string" },
        "records": { "minimum": 0, "type": "integer" },
        "removed": { "minimum": 0, "type": "integer" },
        "runs": { "minimum": 0, "type": "integer" },
        "silent": {
          "const": true,
          "description": "The scheduled source gained no new or changed record within its `silent_after`."
        },
        "source": { "type": "string" },
        "state": { "enum": ["active", "disabled", "historical"] },
        "unchanged": { "minimum": 0, "type": "integer" },
        "updated": { "minimum": 0, "type": "integer" },
        "window": {
          "properties": {
            "since": {
              "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
              "format": "date-time",
              "type": "string"
            },
            "until": {
              "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
              "format": "date-time",
              "type": "string"
            }
          },
          "required": ["since", "until"],
          "type": "object"
        }
      },
      "required": ["enabled", "state", "freshness"],
      "type": "object"
    },
    "Problem": {
      "description": "Why part of a reply may be incomplete; an incomplete empty result does not prove absence.",
      "properties": { "error": { "type": "string" }, "file": { "type": "string" } },
      "required": ["error"],
      "type": "object"
    },
    "Queue": {
      "description": "Durable run, wake and message queue summary without message bodies.",
      "properties": {
        "active_runs": { "minimum": 0, "type": "integer" },
        "failed": { "minimum": 0, "type": "integer" },
        "oldest_pending": { "format": "date-time", "type": ["string", "null"] },
        "pending": { "minimum": 0, "type": "integer" },
        "uncertain": { "minimum": 0, "type": "integer" },
        "wakes": { "minimum": 0, "type": "integer" }
      },
      "required": ["pending", "failed", "uncertain", "wakes"],
      "type": "object"
    },
    "Run": {
      "description": "Counters of the last committed collection, backfill included.",
      "properties": {
        "added": { "minimum": 0, "type": "integer" },
        "elapsed_seconds": { "minimum": 0, "type": "number" },
        "expired": { "minimum": 0, "type": "integer" },
        "forgotten": { "minimum": 0, "type": "integer" },
        "output_bytes": { "minimum": 0, "type": "integer" },
        "reconcile": { "type": "boolean" },
        "records": { "minimum": 0, "type": "integer" },
        "removed": { "minimum": 0, "type": "integer" },
        "requested_end": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        },
        "requested_start": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        },
        "unchanged": { "minimum": 0, "type": "integer" },
        "updated": { "minimum": 0, "type": "integer" }
      },
      "type": "object"
    },
    "Source": {
      "description": "A record source's collection state, indexed totals and latest run.",
      "properties": {
        "bytes": { "description": "The size of the source's record files on disk.", "minimum": 0, "type": "integer" },
        "changed": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        },
        "degraded": {
          "description": "The source's last committed collection reported that it missed `missed` of the `of` parts it tried, such as feeds or accounts, and `runs` committed collections in a row did: its records may lack what those parts hold. A complete collection clears it.",
          "properties": {
            "missed": { "minimum": 1, "type": "integer" },
            "of": { "minimum": 1, "type": "integer" },
            "runs": { "minimum": 1, "type": "integer" }
          },
          "required": ["runs", "missed", "of"],
          "type": "object"
        },
        "error": { "description": "The last attempt's diagnostic; it never quotes provider output.", "type": "string" },
        "failed": { "const": true },
        "failures": { "description": "Consecutive failed attempts.", "minimum": 0, "type": "integer" },
        "freshness": { "enum": ["fresh", "overdue", "never", "manual", "unknown"] },
        "last_collected": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        },
        "last_run": { "$ref": "#/$defs/Run" },
        "latest": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        },
        "log": { "description": "The job's log in the brain, such as logs/NAME.log.", "type": "string" },
        "mode": { "enum": ["window", "cursor", "snapshot"] },
        "reconciled": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        },
        "records": { "minimum": 0, "type": "integer" },
        "silent": {
          "const": true,
          "description": "The scheduled source gained no new or changed record within its `silent_after`."
        },
        "state": { "enum": ["active", "disabled", "historical"] },
        "window": {
          "properties": {
            "since": {
              "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
              "format": "date-time",
              "type": "string"
            },
            "until": {
              "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
              "format": "date-time",
              "type": "string"
            }
          },
          "required": ["since", "until"],
          "type": "object"
        }
      },
      "required": ["state", "freshness", "records", "bytes"],
      "type": "object"
    },
    "Usage": {
      "description": "Local search and read activity over one window.",
      "properties": {
        "empty": { "minimum": 0, "type": "integer" },
        "empty_kinds": { "type": "object" },
        "empty_terms": {
          "items": {
            "properties": { "count": { "minimum": 0, "type": "integer" }, "term": { "type": "string" } },
            "required": ["term", "count"],
            "type": "object"
          },
          "type": "array"
        },
        "kinds": { "type": "object" },
        "read": { "minimum": 0, "type": "integer" },
        "search": { "minimum": 0, "type": "integer" },
        "since": {
          "description": "ISO 8601 date-time with the local offset, such as 2026-09-28T14:00:00+02:00.",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": ["search", "empty", "read"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attention": { "items": { "$ref": "#/$defs/Attention" }, "type": "array" },
    "brain": { "type": "string" },
    "cache": { "enum": ["ready", "busy", "stale", "missing"] },
    "coverage": {
      "properties": {
        "active": {
          "properties": {
            "records": { "minimum": 0, "type": "integer" },
            "sources": { "minimum": 0, "type": "integer" }
          },
          "required": ["sources", "records"],
          "type": "object"
        },
        "disabled": {
          "properties": {
            "records": { "minimum": 0, "type": "integer" },
            "sources": { "minimum": 0, "type": "integer" }
          },
          "required": ["sources", "records"],
          "type": "object"
        },
        "historical": {
          "properties": {
            "records": { "minimum": 0, "type": "integer" },
            "sources": { "minimum": 0, "type": "integer" }
          },
          "required": ["sources", "records"],
          "type": "object"
        }
      },
      "required": ["active", "disabled", "historical"],
      "type": "object"
    },
    "healthy": { "type": "boolean" },
    "index": {
      "properties": {
        "cache": { "enum": ["ready", "busy", "stale", "missing"] },
        "notes": { "minimum": 0, "type": "integer" },
        "records": { "minimum": 0, "type": "integer" },
        "sources": { "minimum": 0, "type": "integer" }
      },
      "required": ["cache", "notes"],
      "type": "object"
    },
    "jobs": { "additionalProperties": { "$ref": "#/$defs/Job" }, "type": "object" },
    "notes": { "minimum": 0, "type": "integer" },
    "path": { "type": "string" },
    "pending_transaction": { "const": true },
    "problems": { "items": { "$ref": "#/$defs/Problem" }, "type": "array" },
    "queue": { "$ref": "#/$defs/Queue" },
    "registered": { "type": "boolean" },
    "runtime": {
      "properties": { "installed": { "type": "string" }, "pinned": { "type": "string" } },
      "required": ["installed"],
      "type": "object"
    },
    "sources": { "additionalProperties": { "$ref": "#/$defs/Source" }, "type": "object" },
    "usage": {
      "properties": { "30d": { "$ref": "#/$defs/Usage" }, "7d": { "$ref": "#/$defs/Usage" } },
      "required": ["7d", "30d"],
      "type": "object"
    },
    "warnings": { "items": { "required": ["warning"], "type": "object" }, "type": "array" }
  },
  "required": [
    "healthy",
    "brain",
    "path",
    "registered",
    "runtime",
    "cache",
    "notes",
    "problems",
    "attention",
    "jobs",
    "sources",
    "coverage",
    "queue",
    "usage"
  ],
  "title": "bf status reply",
  "type": "object"
}
