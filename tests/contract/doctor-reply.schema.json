{
  "$defs": {
    "Problem": {
      "description": "Why part of a reply may be incomplete; an incomplete empty result does not prove absence.",
      "properties": { "error": { "type": "string" }, "file": { "type": "string" } },
      "required": ["error"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "brain": { "type": "string" },
    "healthy": { "type": "boolean" },
    "jobs": {
      "additionalProperties": {
        "properties": {
          "enabled": { "type": "boolean" },
          "error": { "type": "string" },
          "missing_bins": { "items": { "type": "string" }, "type": "array" },
          "missing_env": { "items": { "type": "string" }, "type": "array" },
          "ok": { "type": "boolean" }
        },
        "required": ["enabled", "ok"],
        "type": "object"
      },
      "type": "object"
    },
    "path": { "type": "string" },
    "problems": { "items": { "$ref": "#/$defs/Problem" }, "type": "array" }
  },
  "required": ["healthy", "brain", "path", "jobs", "problems"],
  "title": "bf doctor reply",
  "type": "object"
}
