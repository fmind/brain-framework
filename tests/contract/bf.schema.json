{
  "$defs": {
    "Argv": {
      "description": "Literal argv without a shell (supports {{brain}}, {{loop}}, {{state}}, {{start}}, {{end}}, {{trigger}}, {{run}}).",
      "items": { "maxLength": 4096, "minLength": 1, "type": "string" },
      "maxItems": 64,
      "minItems": 1,
      "title": "Argv",
      "type": "array"
    },
    "CronTrigger": {
      "additionalProperties": false,
      "description": "Cron schedule trigger with optional per-trigger window.",
      "properties": {
        "backfill": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ],
          "default": "1d",
          "description": "Initial BF_START window on first run (now - backfill)."
        },
        "cron": {
          "description": "5-field cron expression or @macro.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^(?:@[A-Za-z]+|[^\\s]+(?:[ \\t]+[^\\s]+){4})$",
          "type": "string"
        },
        "overlap": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 0, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:0|(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+)$", "type": "string" }
          ],
          "default": 0,
          "description": "Rewind on later runs (last_anchor - overlap)."
        }
      },
      "required": ["cron"],
      "title": "CronTrigger",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "description": "Shared loop defaults (timeout, window).",
      "properties": {
        "timeout": {
          "anyOf": [
            { "maximum": 86400, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ],
          "default": "5m",
          "description": "Default cycle timeout for loops."
        },
        "window": { "$ref": "#/$defs/Window" }
      },
      "title": "Defaults",
      "type": ["object", "null"]
    },
    "EventMatch": {
      "additionalProperties": false,
      "description": "Event matcher against logs/events.jsonl.",
      "minProperties": 1,
      "properties": {
        "filter": {
          "description": "Isolated jq boolean expression evaluated per event.",
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "description": "Exact event kind to match (e.g. records.ingested).",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "description": "Exact event source to match (loop name or 'bf').",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "EventMatch",
      "type": "object"
    },
    "EventTrigger": {
      "additionalProperties": false,
      "description": "Event subscription trigger.",
      "properties": {
        "event": {
          "anyOf": [
            { "maxLength": 128, "minLength": 1, "pattern": "^[a-z][a-z0-9._-]{0,127}$", "type": "string" },
            { "$ref": "#/$defs/EventMatch" }
          ],
          "description": "Event kind string or matcher object."
        }
      },
      "required": ["event"],
      "title": "EventTrigger",
      "type": "object"
    },
    "EveryTrigger": {
      "additionalProperties": false,
      "description": "Interval schedule trigger with optional per-trigger window.",
      "properties": {
        "backfill": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ],
          "default": "1d",
          "description": "Initial BF_START window on first run (now - backfill)."
        },
        "every": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ],
          "description": "Repeat interval duration (e.g. 15m, 1h, 1d)."
        },
        "overlap": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 0, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:0|(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+)$", "type": "string" }
          ],
          "default": 0,
          "description": "Rewind on later runs (last_anchor - overlap)."
        }
      },
      "required": ["every"],
      "title": "EveryTrigger",
      "type": "object"
    },
    "Ingest": {
      "additionalProperties": false,
      "description": "Explicit record ingestion target.",
      "minProperties": 1,
      "properties": {
        "mode": {
          "default": "upsert",
          "description": "Write mode: upsert or snapshot.",
          "enum": ["upsert", "snapshot"],
          "type": "string"
        },
        "source": {
          "description": "Target <target>/<source>.jsonl stem (defaults to loop name).",
          "not": {
            "enum": [
              "agents",
              "bf",
              "clients",
              "evals",
              "logs",
              "loops",
              "memories",
              "notes",
              "prompts",
              "record",
              "routines",
              "schemas",
              "sensors",
              "skills",
              "usages"
            ]
          },
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "target": {
          "default": "memories",
          "description": "Record bucket: memories or usages.",
          "enum": ["memories", "usages"],
          "type": "string"
        }
      },
      "title": "Ingest",
      "type": "object"
    },
    "Loop": {
      "additionalProperties": false,
      "allOf": [
        { "if": { "required": ["emit"], "type": "object" }, "then": { "not": { "required": ["ingest"] } } },
        {
          "if": { "properties": { "when": { "const": "daemon" } }, "required": ["when"], "type": "object" },
          "then": {
            "not": { "anyOf": [{ "required": ["window"] }, { "required": ["ingest"] }, { "required": ["timeout"] }] }
          }
        }
      ],
      "description": "One loop entry.",
      "properties": {
        "description": {
          "description": "Short description of what this loop does for humans and AI agents.",
          "maxLength": 512,
          "type": "string"
        },
        "emit": {
          "description": "Default event kind emitted from stdout JSONL to logs/events.jsonl.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "description": "Enable automatic triggers and daemon supervision.",
          "type": "boolean"
        },
        "env": {
          "additionalProperties": { "maxLength": 4096, "type": "string" },
          "description": "Loop environment variable overrides.",
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "type": ["object", "null"]
        },
        "ingest": {
          "anyOf": [
            { "const": false },
            { "enum": ["upsert", "snapshot"], "type": "string" },
            { "$ref": "#/$defs/Ingest" }
          ],
          "description": "Ingest stdout JSONL into memories/ or usages/ ('upsert'|'snapshot'|{source?, target?, mode?}), or false to disable sensors/ auto-ingest."
        },
        "run": { "$ref": "#/$defs/Argv" },
        "timeout": {
          "anyOf": [
            { "maximum": 86400, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ],
          "default": "5m",
          "description": "Max cycle runtime before terminating the process group."
        },
        "when": {
          "anyOf": [
            { "const": "daemon" },
            {
              "anyOf": [
                {
                  "anyOf": [
                    { "maximum": 315576000, "minimum": 1, "type": "integer" },
                    { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" },
                    {
                      "maxLength": 128,
                      "minLength": 1,
                      "pattern": "^(?:@[A-Za-z]+|[^\\s]+(?:[ \\t]+[^\\s]+){4})$",
                      "type": "string"
                    }
                  ]
                },
                { "$ref": "#/$defs/EveryTrigger" },
                { "$ref": "#/$defs/CronTrigger" },
                { "$ref": "#/$defs/EventTrigger" }
              ]
            },
            {
              "items": {
                "anyOf": [
                  {
                    "anyOf": [
                      { "maximum": 315576000, "minimum": 1, "type": "integer" },
                      { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" },
                      {
                        "maxLength": 128,
                        "minLength": 1,
                        "pattern": "^(?:@[A-Za-z]+|[^\\s]+(?:[ \\t]+[^\\s]+){4})$",
                        "type": "string"
                      }
                    ]
                  },
                  { "$ref": "#/$defs/EveryTrigger" },
                  { "$ref": "#/$defs/CronTrigger" },
                  { "$ref": "#/$defs/EventTrigger" }
                ]
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "When the loop runs: 'daemon', a trigger, a list of triggers, or omit for manual."
        },
        "window": { "$ref": "#/$defs/Window" }
      },
      "title": "Loop",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "description": "Default time window for BF_START/BF_END.",
      "minProperties": 1,
      "properties": {
        "backfill": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ],
          "default": "1d",
          "description": "Initial BF_START window on first run (now - backfill)."
        },
        "overlap": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 0, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:0|(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+)$", "type": "string" }
          ],
          "default": 0,
          "description": "Rewind on later runs (last_anchor - overlap)."
        }
      },
      "title": "Window",
      "type": "object"
    }
  },
  "$id": "https://fmind.github.io/brain-framework/bf.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Brain Framework configuration and loop orchestration (bf.yaml).",
  "properties": {
    "brains": {
      "additionalProperties": { "maxLength": 4096, "minLength": 1, "type": "string" },
      "description": "Sibling brain aliases for bf://.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "concurrency": {
      "default": 4,
      "description": "Max concurrent cycle loops in bf watch and bf run --due (1..32).",
      "maximum": 32,
      "minimum": 1,
      "type": "integer"
    },
    "defaults": { "$ref": "#/$defs/Defaults" },
    "description": {
      "description": "Short description of this brain's scope for humans and AI agents.",
      "maxLength": 1024,
      "type": "string"
    },
    "env": {
      "additionalProperties": { "maxLength": 4096, "type": "string" },
      "description": "Shared environment variables for loops.",
      "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "type": ["object", "null"]
    },
    "loops": {
      "additionalProperties": { "$ref": "#/$defs/Loop" },
      "description": "Unified loop definitions.",
      "propertyNames": { "not": { "enum": ["events"] }, "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "name": {
      "description": "Stable lowercase identifier for this brain.",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "notes": {
      "default": ["concepts", "projects", "actions"],
      "description": "Top-level Markdown note folders compiled into memories/<dir>.jsonl.",
      "items": {
        "not": {
          "enum": [
            "agents",
            "bf",
            "clients",
            "evals",
            "logs",
            "loops",
            "memories",
            "notes",
            "prompts",
            "record",
            "routines",
            "schemas",
            "sensors",
            "skills",
            "usages"
          ]
        },
        "pattern": "^[a-z][a-z0-9-]{0,63}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "timezone": {
      "default": "UTC",
      "description": "IANA timezone for cron schedules.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "version": { "const": 18, "description": "Brain configuration format version.", "type": "integer" }
  },
  "required": ["version", "name"],
  "title": "Config",
  "type": "object"
}
