{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": { "keep": { "maximum": 1000, "minimum": 1, "type": "integer" } },
      "required": ["keep"],
      "title": "Action",
      "type": "object"
    },
    "Argv": {
      "items": { "maxLength": 4096, "minLength": 1, "type": "string" },
      "maxItems": 64,
      "minItems": 1,
      "title": "Argv",
      "type": "array"
    },
    "EventMatch": {
      "additionalProperties": false,
      "properties": {
        "filter": { "maxLength": 2048, "minLength": 1, "type": "string" },
        "kind": { "maxLength": 128, "minLength": 1, "type": "string" },
        "source": { "maxLength": 128, "minLength": 1, "type": "string" }
      },
      "title": "EventMatch",
      "type": "object"
    },
    "Ingest": {
      "additionalProperties": false,
      "properties": {
        "allow_removal": { "type": "boolean" },
        "mode": { "enum": ["upsert", "snapshot"], "type": "string" },
        "source": { "pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string" }
      },
      "required": ["source"],
      "title": "Ingest",
      "type": "object"
    },
    "Loop": {
      "additionalProperties": false,
      "allOf": [
        { "not": { "required": ["ingest", "action"] } },
        {
          "if": { "properties": { "emit": { "not": { "const": false } } }, "required": ["emit"] },
          "then": { "not": { "anyOf": [{ "required": ["ingest"] }, { "required": ["action"] }] } }
        },
        {
          "if": { "properties": { "daemon": { "const": true } }, "required": ["daemon"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["schedule"] },
                { "required": ["events"] },
                { "required": ["hook"] },
                { "required": ["input"] },
                { "required": ["ingest"] },
                { "required": ["action"] },
                { "required": ["lookback"] },
                { "required": ["overlap"] },
                { "required": ["timeout"] }
              ]
            }
          }
        }
      ],
      "properties": {
        "action": { "$ref": "#/$defs/Action" },
        "daemon": { "type": "boolean" },
        "emit": {
          "anyOf": [
            { "type": "boolean" },
            { "maxLength": 128, "minLength": 1, "pattern": "^[a-z][a-z0-9._-]{0,127}$", "type": "string" }
          ]
        },
        "enabled": { "type": "boolean" },
        "env": {
          "additionalProperties": { "maxLength": 4096, "type": "string" },
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "type": "object"
        },
        "events": { "items": { "$ref": "#/$defs/EventMatch" }, "maxItems": 32, "minItems": 1, "type": "array" },
        "hook": {
          "anyOf": [
            { "enum": ["pre-commit", "pre-push"], "type": "string" },
            {
              "items": { "enum": ["pre-commit", "pre-push"], "type": "string" },
              "maxItems": 2,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          ]
        },
        "ingest": {
          "anyOf": [{ "pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string" }, { "$ref": "#/$defs/Ingest" }]
        },
        "input": { "maxLength": 1024, "minLength": 1, "type": "string" },
        "lookback": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ]
        },
        "overlap": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 0, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:0|(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+)$", "type": "string" }
          ]
        },
        "requires": {
          "items": { "maxLength": 256, "minLength": 1, "type": "string" },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "run": { "$ref": "#/$defs/Argv" },
        "schedule": {
          "anyOf": [
            {
              "anyOf": [
                { "maximum": 315576000, "minimum": 1, "type": "integer" },
                { "maxLength": 128, "minLength": 1, "type": "string" }
              ]
            },
            {
              "items": {
                "anyOf": [
                  { "maximum": 315576000, "minimum": 1, "type": "integer" },
                  { "maxLength": 128, "minLength": 1, "type": "string" }
                ]
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array"
            }
          ]
        },
        "timeout": {
          "anyOf": [
            { "maximum": 86400, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ]
        }
      },
      "required": ["run"],
      "title": "Loop",
      "type": "object"
    }
  },
  "$id": "https://fmind.github.io/brain-framework/bf.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Brain Framework configuration and loop orchestration (bf.yaml).",
  "properties": {
    "brains": {
      "additionalProperties": { "maxLength": 4096, "minLength": 1, "type": "string" },
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "env": {
      "additionalProperties": { "maxLength": 4096, "type": "string" },
      "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "type": ["object", "null"]
    },
    "loops": {
      "additionalProperties": { "$ref": "#/$defs/Loop" },
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "name": {
      "description": "Stable lowercase identifier for this brain.",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "timezone": { "maxLength": 128, "minLength": 1, "type": "string" },
    "version": { "const": 15, "description": "Brain configuration format version.", "type": "integer" },
    "watch": {
      "additionalProperties": false,
      "properties": {
        "concurrency": { "maximum": 32, "minimum": 1, "type": "integer" },
        "debounce": {
          "anyOf": [
            { "maximum": 60, "minimum": 0.05, "type": "number" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ]
        },
        "interval": {
          "anyOf": [
            { "maximum": 3600, "minimum": 0.5, "type": "number" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ]
        }
      },
      "type": ["object", "null"]
    }
  },
  "required": ["version", "name"],
  "title": "Config",
  "type": "object"
}
