{
  "$defs": {
    "Argv": {
      "description": "Literal argv without a shell.",
      "items": { "maxLength": 4096, "minLength": 1, "type": "string" },
      "maxItems": 64,
      "minItems": 1,
      "title": "Argv",
      "type": "array"
    },
    "EventMatch": {
      "additionalProperties": false,
      "description": "Event matcher against .bf/events.jsonl.",
      "minProperties": 1,
      "properties": {
        "filter": {
          "description": "Isolated jq boolean expression evaluated per event.",
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "description": "Exact event kind to match (e.g. records.ingested).",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "description": "Exact event source to match (loop name or 'bf').",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "EventMatch",
      "type": "object"
    },
    "Ingest": {
      "additionalProperties": false,
      "description": "Explicit memory ingestion target.",
      "properties": {
        "mode": {
          "default": "upsert",
          "description": "Write mode: upsert or snapshot.",
          "enum": ["upsert", "snapshot"],
          "type": "string"
        },
        "source": {
          "description": "Target memories/<source>/ folder.",
          "not": {
            "enum": ["actions", "bf", "concepts", "evals", "logs", "loops", "memories", "notes", "projects", "record"]
          },
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        }
      },
      "required": ["source"],
      "title": "Ingest",
      "type": "object"
    },
    "Loop": {
      "additionalProperties": false,
      "allOf": [
        { "if": { "required": ["emit"] }, "then": { "not": { "required": ["ingest"] } } },
        {
          "if": { "properties": { "on": { "const": "daemon" } }, "required": ["on"] },
          "then": {
            "not": { "anyOf": [{ "required": ["window"] }, { "required": ["ingest"] }, { "required": ["timeout"] }] }
          }
        }
      ],
      "description": "One loop entry.",
      "properties": {
        "description": {
          "description": "Short summary of what this loop does for humans and AI agents.",
          "maxLength": 512,
          "type": "string"
        },
        "emit": {
          "description": "Default event kind emitted from stdout JSONL to .bf/events.jsonl (e.g. loop.event).",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "description": "Enable automatic triggers and daemon supervision.",
          "type": "boolean"
        },
        "env": {
          "additionalProperties": { "maxLength": 4096, "type": "string" },
          "description": "Loop environment overrides (expands {{brain}}, {{home}}, {{state}}).",
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "type": ["object", "null"]
        },
        "ingest": {
          "anyOf": [{ "enum": ["upsert", "snapshot"], "type": "string" }, { "$ref": "#/$defs/Ingest" }],
          "description": "Ingest stdout JSON into memories/<loop>/ ('upsert'|'snapshot') or {source, mode}."
        },
        "on": {
          "anyOf": [{ "const": "daemon" }, { "$ref": "#/$defs/Trigger" }],
          "description": "When the loop runs: 'daemon' for continuous supervision, a trigger map, or omit for manual."
        },
        "requires": {
          "description": "Required CLI executables verified on PATH.",
          "items": { "maxLength": 256, "minLength": 1, "type": "string" },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "run": { "$ref": "#/$defs/Argv" },
        "timeout": {
          "anyOf": [
            { "maximum": 86400, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ],
          "default": "5m",
          "description": "Max cycle runtime before terminating the process group."
        },
        "window": { "$ref": "#/$defs/Window" }
      },
      "required": ["run"],
      "title": "Loop",
      "type": "object"
    },
    "Trigger": {
      "additionalProperties": false,
      "description": "When a cycle loop runs.",
      "minProperties": 1,
      "properties": {
        "events": {
          "anyOf": [
            {
              "anyOf": [
                { "maxLength": 128, "minLength": 1, "pattern": "^[a-z][a-z0-9._-]{0,127}$", "type": "string" },
                { "$ref": "#/$defs/EventMatch" }
              ]
            },
            {
              "items": {
                "anyOf": [
                  { "maxLength": 128, "minLength": 1, "pattern": "^[a-z][a-z0-9._-]{0,127}$", "type": "string" },
                  { "$ref": "#/$defs/EventMatch" }
                ]
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "Event kind, matcher object, or list subscribed from .bf/events.jsonl."
        },
        "hooks": {
          "anyOf": [
            { "enum": ["pre-commit", "pre-push"], "type": "string" },
            {
              "items": { "enum": ["pre-commit", "pre-push"], "type": "string" },
              "maxItems": 2,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          ],
          "description": "Git hook or list of hooks that trigger this loop (pre-commit, pre-push)."
        },
        "schedules": {
          "anyOf": [
            {
              "anyOf": [
                { "maximum": 315576000, "minimum": 1, "type": "integer" },
                { "maxLength": 128, "minLength": 1, "type": "string" }
              ]
            },
            {
              "items": {
                "anyOf": [
                  { "maximum": 315576000, "minimum": 1, "type": "integer" },
                  { "maxLength": 128, "minLength": 1, "type": "string" }
                ]
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "Duration (1h, 1d), @macro, 5-field cron, or a list of schedules."
        }
      },
      "title": "Trigger",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "description": "Time window for {{start}}/{{end}}.",
      "minProperties": 1,
      "properties": {
        "backfill": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ],
          "default": "1d",
          "description": "Initial {{start}} window on first run (now - backfill)."
        },
        "overlap": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 0, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:0|(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+)$", "type": "string" }
          ],
          "default": 0,
          "description": "Rewind on later runs (last_anchor - overlap)."
        }
      },
      "title": "Window",
      "type": "object"
    }
  },
  "$id": "https://fmind.github.io/brain-framework/bf.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Brain Framework configuration and loop orchestration (bf.yaml).",
  "properties": {
    "brains": {
      "additionalProperties": { "maxLength": 4096, "minLength": 1, "type": "string" },
      "description": "Sibling brain aliases for bf:// links.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "description": {
      "description": "Short summary of this brain's scope for humans and AI agents.",
      "maxLength": 1024,
      "type": "string"
    },
    "env": {
      "additionalProperties": { "maxLength": 4096, "type": "string" },
      "description": "Base environment variables for loops (expands {{brain}}, {{home}}, {{state}}).",
      "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "type": ["object", "null"]
    },
    "loops": {
      "additionalProperties": { "$ref": "#/$defs/Loop" },
      "description": "Unified loop definitions.",
      "patternProperties": {
        "^(?:actions|bf|concepts|evals|logs|loops|memories|notes|projects|record)$": {
          "$ref": "#/$defs/Loop",
          "not": { "properties": { "ingest": { "type": "string" } }, "required": ["ingest"] }
        }
      },
      "propertyNames": { "not": { "enum": ["events", "cache"] }, "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "name": {
      "description": "Stable lowercase identifier for this brain.",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "timezone": {
      "default": "UTC",
      "description": "IANA timezone for cron schedules and new note dates.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "version": { "const": 16, "description": "Brain configuration format version.", "type": "integer" },
    "watch": {
      "additionalProperties": false,
      "description": "Polling interval and concurrency for bf watch and bf run --due.",
      "properties": {
        "concurrency": {
          "default": 4,
          "description": "Max concurrent cycle loops in bf watch and bf run --due (1..32).",
          "maximum": 32,
          "minimum": 1,
          "type": "integer"
        },
        "interval": {
          "anyOf": [
            { "maximum": 3600, "minimum": 0.5, "type": "number" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ],
          "default": "5s",
          "description": "Schedule polling interval for bf watch (500ms..1h)."
        }
      },
      "type": ["object", "null"]
    }
  },
  "required": ["version", "name"],
  "title": "Config",
  "type": "object"
}
