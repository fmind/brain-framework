{
  "$schema": "https://dprint.dev/schemas/v0.json",
  // https://dprint.dev/config/
  "lineWidth": 120,
  "markdown": {
    "textWrap": "never"
  },
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0"
  ]
}
