{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectsNote",
  "description": "Domain schema for authored Markdown notes in projects/.",
  "type": "object",
  "required": [
    "type",
    "status"
  ],
  "additionalProperties": true,
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "done",
        "archived"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 16384
    },
    "created": {
      "type": "string",
      "minLength": 10,
      "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|[12][0-9]))(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2}))?)?$"
    },
    "updated": {
      "type": "string",
      "minLength": 10,
      "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|[12][0-9]))(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2}))?)?$"
    }
  }
}
