{
  "$id": "https://fmind.github.io/brain-framework/concepts.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "User-customizable schema enforced on concept records compiled from concepts/ (schemas/concepts.json).",
  "properties": {
    "sources": {
      "items": {
        "additionalProperties": true,
        "properties": { "resource": { "maxLength": 8192, "minLength": 1, "type": "string" } },
        "required": ["resource"],
        "type": "object"
      },
      "maxItems": 200,
      "type": "array"
    },
    "status": { "enum": ["draft", "stable", "deprecated"], "type": "string" },
    "summary": { "maxLength": 16384, "type": "string" },
    "tags": {
      "items": { "maxLength": 128, "minLength": 1, "pattern": "^[^/\\\\\\s]+$", "type": "string" },
      "maxItems": 200,
      "type": "array",
      "uniqueItems": true
    },
    "type": { "pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string" },
    "updated": { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "type": "string" }
  },
  "required": ["type", "status"],
  "title": "Concept",
  "type": "object"
}
