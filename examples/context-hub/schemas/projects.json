{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectsNote",
  "description": "Domain schema for authored Markdown notes in projects/.",
  "type": "object",
  "required": [
    "type",
    "status"
  ],
  "additionalProperties": true,
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    }
  }
}
