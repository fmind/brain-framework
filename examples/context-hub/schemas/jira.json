{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JiraRecord",
  "type": "object",
  "required": ["type", "status", "project"],
  "additionalProperties": true,
  "properties": {
    "type": { "type": "string", "const": "issue" },
    "status": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "pattern": "^projects/.+\\.md$" }
  }
}
