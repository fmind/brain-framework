{
  "$defs": {
    "BrainReference": {
      "additionalProperties": false,
      "description": "A directly related brain, located relative to the declaring brain.",
      "properties": { "path": { "maxLength": 4096, "minLength": 1, "title": "Path", "type": "string" } },
      "required": ["path"],
      "title": "BrainReference",
      "type": "object"
    },
    "JsonValue": {},
    "Mapping": {
      "additionalProperties": false,
      "description": "One JSON Pointer into sensor output, or one literal value; never executable expressions.",
      "properties": {
        "path": {
          "anyOf": [{ "maxLength": 4096, "type": "string" }, { "type": "null" }],
          "default": null,
          "title": "Path"
        },
        "value": { "$ref": "#/$defs/JsonValue", "default": null }
      },
      "title": "Mapping",
      "type": "object"
    },
    "Routine": {
      "additionalProperties": false,
      "description": "A deterministic program whose Markdown output becomes the day's action for review.",
      "properties": {
        "command": {
          "items": { "type": "string" },
          "maxItems": 128,
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "enabled": { "default": true, "title": "Enabled", "type": "boolean" },
        "lookback": { "default": 86400, "maximum": 31536000, "minimum": 1, "title": "Lookback", "type": "integer" },
        "max_bytes": { "default": 1048576, "maximum": 4194304, "minimum": 1, "title": "Max Bytes", "type": "integer" },
        "refresh": { "default": 0, "maximum": 31536000, "minimum": 0, "title": "Refresh", "type": "integer" },
        "timeout": { "default": 300, "maximum": 3600, "minimum": 1, "title": "Timeout", "type": "integer" }
      },
      "required": ["command"],
      "title": "Routine",
      "type": "object"
    },
    "SchemaField": {
      "additionalProperties": false,
      "description": "A shared meaning; cardinality applies when a sensor maps this field.",
      "properties": {
        "cardinality": {
          "default": "optional",
          "enum": ["one", "optional", "many"],
          "title": "Cardinality",
          "type": "string"
        },
        "description": { "maxLength": 4096, "minLength": 1, "title": "Description", "type": "string" },
        "examples": { "items": { "$ref": "#/$defs/JsonValue" }, "maxItems": 20, "title": "Examples", "type": "array" },
        "relation": { "default": false, "title": "Relation", "type": "boolean" },
        "type": {
          "enum": ["string", "integer", "number", "boolean", "timestamp", "identity"],
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["description", "type"],
      "title": "SchemaField",
      "type": "object"
    },
    "Sensor": {
      "additionalProperties": false,
      "description": "Execution and explicit mapping of sensor output into the shared schema.",
      "properties": {
        "command": {
          "items": { "type": "string" },
          "maxItems": 128,
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "enabled": { "default": true, "title": "Enabled", "type": "boolean" },
        "fields": {
          "patternProperties": { "^[a-z][a-z0-9-]{0,63}$": { "$ref": "#/$defs/Mapping" } },
          "title": "Fields",
          "type": "object"
        },
        "lookback": { "default": 86400, "maximum": 31536000, "minimum": 1, "title": "Lookback", "type": "integer" },
        "max_bytes": {
          "default": 67108864,
          "maximum": 268435456,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "mode": { "default": "window", "enum": ["window", "snapshot"], "title": "Mode", "type": "string" },
        "overlap": { "default": 300, "maximum": 31536000, "minimum": 0, "title": "Overlap", "type": "integer" },
        "refresh": { "default": 0, "maximum": 31536000, "minimum": 0, "title": "Refresh", "type": "integer" },
        "timeout": { "default": 300, "maximum": 3600, "minimum": 1, "title": "Timeout", "type": "integer" },
        "trust": { "default": "external", "enum": ["owner", "external"], "title": "Trust", "type": "string" }
      },
      "required": ["command"],
      "title": "Sensor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One brain: its name, related brains, shared schema, and the sensors and routines it may run.",
  "properties": {
    "brains": {
      "maxProperties": 32,
      "patternProperties": { "^[a-z][a-z0-9-]{0,63}$": { "$ref": "#/$defs/BrainReference" } },
      "title": "Brains",
      "type": "object"
    },
    "name": { "pattern": "^[a-z][a-z0-9-]{0,63}$", "title": "Name", "type": "string" },
    "routines": {
      "patternProperties": { "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": { "$ref": "#/$defs/Routine" } },
      "propertyNames": { "maxLength": 64 },
      "title": "Routines",
      "type": "object"
    },
    "schema": {
      "patternProperties": { "^[a-z][a-z0-9-]{0,63}$": { "$ref": "#/$defs/SchemaField" } },
      "title": "Schema",
      "type": "object"
    },
    "sensors": {
      "patternProperties": { "^[a-z][a-z0-9-]{0,63}$": { "$ref": "#/$defs/Sensor" } },
      "title": "Sensors",
      "type": "object"
    },
    "version": { "const": 5, "default": 5, "title": "Version", "type": "integer" }
  },
  "required": ["name"],
  "title": "Config",
  "type": "object"
}
