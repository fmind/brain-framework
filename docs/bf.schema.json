{
  "$defs": {
    "Argv": {
      "description": "Literal argv without a shell (supports {{brain}}, {{loop}}, {{state}}, {{start}}, {{end}}, {{trigger}}, {{run}}).",
      "items": { "maxLength": 4096, "minLength": 1, "type": "string" },
      "maxItems": 64,
      "minItems": 1,
      "title": "Argv",
      "type": "array"
    },
    "EventMatch": {
      "additionalProperties": false,
      "description": "Event matcher against .bf/state/events.jsonl.",
      "minProperties": 1,
      "properties": {
        "kind": {
          "description": "Exact event kind to match (lowercase letters, digits, '.', '_', '-'; e.g. records.ingested).",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "source": {
          "description": "Exact event source to match (lowercase loop name or 'bf').",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "where": {
          "additionalProperties": {
            "anyOf": [
              { "type": ["string", "number", "integer", "boolean", "null"] },
              {
                "additionalProperties": false,
                "properties": {
                  "in": {
                    "items": { "type": ["string", "number", "integer", "boolean", "null"] },
                    "maxItems": 64,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": ["in"],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": { "exists": { "type": "boolean" } },
                "required": ["exists"],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": { "prefix": { "maxLength": 512, "minLength": 1, "type": "string" } },
                "required": ["prefix"],
                "type": "object"
              }
            ]
          },
          "description": "Declarative dot-path predicates evaluated against the event object.",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$" },
          "type": "object"
        }
      },
      "title": "EventMatch",
      "type": "object"
    },
    "EventTrigger": {
      "additionalProperties": false,
      "description": "Event subscription trigger with optional trailing-edge debounce.",
      "properties": {
        "debounce": {
          "description": "Trailing-edge coalesce window before firing (1s..1h, e.g. 10s).",
          "maxLength": 32,
          "pattern": "^(?:[0-9]+(?:s|m|h|d|w|y))+$",
          "type": "string"
        },
        "event": {
          "anyOf": [
            { "maxLength": 128, "minLength": 1, "pattern": "^[a-z][a-z0-9._-]{0,127}$", "type": "string" },
            { "$ref": "#/$defs/EventMatch" }
          ],
          "description": "Event kind string or matcher object."
        }
      },
      "required": ["event"],
      "title": "EventTrigger",
      "type": "object"
    },
    "Ingest": {
      "additionalProperties": false,
      "description": "Explicit record ingestion target.",
      "minProperties": 1,
      "properties": {
        "mode": {
          "default": "upsert",
          "description": "Write mode: upsert or snapshot.",
          "enum": ["upsert", "snapshot"],
          "type": "string"
        },
        "schema": {
          "description": "Optional schemas/<schema>.json name (for year-partitioned sources).",
          "not": {
            "enum": [
              "agents",
              "bf",
              "clients",
              "evals",
              "http",
              "https",
              "logs",
              "mailto",
              "memories",
              "notes",
              "prompts",
              "record",
              "routines",
              "schemas",
              "sensors",
              "urn"
            ]
          },
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "source": {
          "description": "Target memories/<source>.jsonl stem (defaults to loop name).",
          "not": {
            "enum": [
              "agents",
              "bf",
              "clients",
              "evals",
              "http",
              "https",
              "logs",
              "mailto",
              "memories",
              "notes",
              "prompts",
              "record",
              "routines",
              "schemas",
              "sensors",
              "urn"
            ]
          },
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        }
      },
      "title": "Ingest",
      "type": "object"
    },
    "Loop": {
      "additionalProperties": false,
      "allOf": [
        { "if": { "required": ["emit"], "type": "object" }, "then": { "not": { "required": ["ingest"] } } },
        {
          "if": { "properties": { "when": { "const": "daemon" } }, "required": ["when"], "type": "object" },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["window"] },
                { "required": ["ingest"] },
                { "required": ["timeout"] },
                { "required": ["pool"] }
              ]
            }
          }
        }
      ],
      "description": "One loop entry.",
      "properties": {
        "description": {
          "description": "Short description of what this loop does for humans and AI agents.",
          "maxLength": 512,
          "type": "string"
        },
        "emit": {
          "description": "Default event kind emitted from stdout JSONL to .bf/state/events.jsonl.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "description": "Enable automatic triggers and daemon supervision.",
          "type": "boolean"
        },
        "env": {
          "additionalProperties": { "maxLength": 4096, "type": "string" },
          "description": "Explicit loop environment variable values (blocks linker/interpreter hijack keys).",
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "type": ["object", "null"]
        },
        "env_from": {
          "description": "Host or .env variable names explicitly allowed into this loop.",
          "items": { "maxLength": 128, "minLength": 1, "pattern": "^[A-Z_][A-Z0-9_]*$", "type": "string" },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        },
        "ingest": {
          "anyOf": [{ "enum": ["upsert", "snapshot"], "type": "string" }, { "$ref": "#/$defs/Ingest" }],
          "description": "Explicitly ingest stdout JSONL into memories/<source>.jsonl ('upsert'|'snapshot'|{source?, mode?, schema?})."
        },
        "pool": {
          "description": "Named concurrency pool declared under bf.yaml concurrency: (default: 'default').",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "run": { "$ref": "#/$defs/Argv" },
        "timeout": {
          "default": "5m",
          "description": "Max cycle runtime as explicit duration (1s..24h, e.g. 5m, 15m).",
          "maxLength": 32,
          "pattern": "^(?:[0-9]+(?:s|m|h|d|w|y))+$",
          "type": "string"
        },
        "when": {
          "anyOf": [
            { "const": "daemon" },
            {
              "anyOf": [
                { "maxLength": 32, "pattern": "^(?:[0-9]+(?:s|m|h|d|w|y))+$", "type": "string" },
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^(?:@[A-Za-z]+|[^\\s]+(?:[ \\t]+[^\\s]+){4})$",
                  "type": "string"
                },
                { "$ref": "#/$defs/ScheduleTrigger" },
                { "$ref": "#/$defs/EventTrigger" }
              ]
            },
            {
              "items": {
                "anyOf": [
                  { "maxLength": 32, "pattern": "^(?:[0-9]+(?:s|m|h|d|w|y))+$", "type": "string" },
                  {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^(?:@[A-Za-z]+|[^\\s]+(?:[ \\t]+[^\\s]+){4})$",
                    "type": "string"
                  },
                  { "$ref": "#/$defs/ScheduleTrigger" },
                  { "$ref": "#/$defs/EventTrigger" }
                ]
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "When the loop runs: 'daemon', duration ('1h'), cron ('0 8 * * 0'), {every|cron, backfill?, overlap?}, {event, debounce?}, list, or omit for manual."
        },
        "window": { "$ref": "#/$defs/Window" }
      },
      "title": "Loop",
      "type": "object"
    },
    "ScheduleTrigger": {
      "additionalProperties": false,
      "description": "Interval or cron trigger with optional per-trigger BF_START window override.",
      "oneOf": [{ "required": ["every"] }, { "required": ["cron"] }],
      "properties": {
        "backfill": {
          "description": "Per-trigger initial BF_START window override.",
          "maxLength": 32,
          "pattern": "^(?:[0-9]+(?:s|m|h|d|w|y))+$",
          "type": "string"
        },
        "cron": {
          "description": "5-field POSIX cron expression or @macro.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^(?:@[A-Za-z]+|[^\\s]+(?:[ \\t]+[^\\s]+){4})$",
          "type": "string"
        },
        "every": {
          "description": "Interval schedule duration (e.g. 1h, 1d).",
          "maxLength": 32,
          "pattern": "^(?:[0-9]+(?:s|m|h|d|w|y))+$",
          "type": "string"
        },
        "overlap": {
          "anyOf": [
            { "const": 0 },
            { "maxLength": 32, "pattern": "^(?:0|(?:[0-9]+(?:s|m|h|d|w|y))+)$", "type": "string" }
          ],
          "description": "Per-trigger BF_START rewind override."
        }
      },
      "title": "ScheduleTrigger",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "description": "Time window for BF_START/BF_END.",
      "minProperties": 1,
      "properties": {
        "backfill": {
          "default": "1d",
          "description": "Initial BF_START window on first run (now - backfill).",
          "maxLength": 32,
          "pattern": "^(?:[0-9]+(?:s|m|h|d|w|y))+$",
          "type": "string"
        },
        "overlap": {
          "anyOf": [
            { "const": 0 },
            { "maxLength": 32, "pattern": "^(?:0|(?:[0-9]+(?:s|m|h|d|w|y))+)$", "type": "string" }
          ],
          "default": "0s",
          "description": "Rewind on later runs (last_anchor - overlap)."
        }
      },
      "title": "Window",
      "type": "object"
    }
  },
  "$id": "https://fmind.github.io/brain-framework/bf.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Brain Framework configuration and loop orchestration (bf.yaml).",
  "properties": {
    "brains": {
      "additionalProperties": { "maxLength": 4096, "minLength": 1, "type": "string" },
      "description": "Sibling brain aliases for bf://.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "concurrency": {
      "anyOf": [
        { "maximum": 32, "minimum": 1, "type": "integer" },
        {
          "additionalProperties": { "maximum": 32, "minimum": 1, "type": "integer" },
          "maxProperties": 32,
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "type": "object"
        }
      ],
      "default": 4,
      "description": "Max concurrent cycle loops (1..32) or named concurrency pools ({default: 4, agents: 2})."
    },
    "description": {
      "description": "Short description of this brain's scope for humans and AI agents.",
      "maxLength": 1024,
      "type": "string"
    },
    "env": {
      "additionalProperties": { "maxLength": 4096, "type": "string" },
      "description": "Shared explicit environment variables for loops.",
      "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "type": ["object", "null"]
    },
    "loops": {
      "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/Loop" }, { "type": "null" }] },
      "description": "Unified loop definitions.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "name": {
      "description": "Stable lowercase identifier for this brain.",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "notes": {
      "default": ["concepts", "projects", "actions"],
      "description": "Top-level Markdown note folders compiled into memories/_notes.jsonl.",
      "items": {
        "not": {
          "enum": [
            "agents",
            "bf",
            "clients",
            "evals",
            "http",
            "https",
            "logs",
            "mailto",
            "memories",
            "notes",
            "prompts",
            "record",
            "routines",
            "schemas",
            "sensors",
            "urn"
          ]
        },
        "pattern": "^[a-z][a-z0-9-]{0,63}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "search": {
      "additionalProperties": false,
      "description": "Default retrieval settings.",
      "minProperties": 1,
      "properties": {
        "exclude": {
          "description": "Memory sources excluded from unscoped bf query by default (override via --scope or --all-sources).",
          "items": {
            "not": {
              "enum": [
                "agents",
                "bf",
                "clients",
                "evals",
                "http",
                "https",
                "logs",
                "mailto",
                "memories",
                "notes",
                "prompts",
                "record",
                "routines",
                "schemas",
                "sensors",
                "urn"
              ]
            },
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": ["object", "null"]
    },
    "timezone": {
      "default": "UTC",
      "description": "IANA timezone for cron schedules.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "version": { "const": 19, "description": "Brain configuration format version.", "type": "integer" }
  },
  "required": ["version", "name"],
  "title": "Config",
  "type": "object"
}
