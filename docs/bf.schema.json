{
  "$defs": {
    "Argv": {
      "items": { "maxLength": 4096, "minLength": 1, "type": "string" },
      "maxItems": 64,
      "minItems": 1,
      "title": "Argv",
      "type": "array"
    },
    "Channel": {
      "additionalProperties": false,
      "anyOf": [{ "required": ["listen"] }, { "required": ["send"] }],
      "properties": {
        "enabled": { "type": "boolean" },
        "env": {
          "additionalProperties": { "maxLength": 4096, "type": "string" },
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "type": "object"
        },
        "listen": { "$ref": "#/$defs/Argv" },
        "requires": {
          "items": { "maxLength": 256, "minLength": 1, "type": "string" },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "send": { "$ref": "#/$defs/Argv" },
        "timeout": {
          "anyOf": [
            { "maximum": 86400, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ]
        }
      },
      "title": "Channel",
      "type": "object"
    },
    "EventMatch": {
      "additionalProperties": false,
      "properties": {
        "filter": { "maxLength": 2048, "minLength": 1, "type": "string" },
        "kind": { "maxLength": 128, "minLength": 1, "type": "string" },
        "source": { "maxLength": 128, "minLength": 1, "type": "string" }
      },
      "title": "EventMatch",
      "type": "object"
    },
    "Ingest": {
      "additionalProperties": false,
      "properties": {
        "allow_removal": { "type": "boolean" },
        "mode": { "enum": ["upsert", "snapshot"], "type": "string" },
        "source": { "pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string" }
      },
      "required": ["source"],
      "title": "Ingest",
      "type": "object"
    },
    "Job": {
      "additionalProperties": false,
      "oneOf": [{ "required": ["run"] }, { "required": ["builtin"] }],
      "properties": {
        "at": { "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$", "type": "string" },
        "builtin": { "enum": ["build", "validate", "review", "eval"], "type": "string" },
        "channel": { "pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string" },
        "days": {
          "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"], "type": "string" },
          "maxItems": 7,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "emit": { "enum": ["none", "action", "events"], "type": "string" },
        "enabled": { "type": "boolean" },
        "env": {
          "additionalProperties": { "maxLength": 4096, "type": "string" },
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "type": "object"
        },
        "events": { "items": { "$ref": "#/$defs/EventMatch" }, "maxItems": 32, "minItems": 1, "type": "array" },
        "every": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ]
        },
        "hook": {
          "anyOf": [
            { "enum": ["pre-commit", "pre-push"], "type": "string" },
            {
              "items": { "enum": ["pre-commit", "pre-push"], "type": "string" },
              "maxItems": 2,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          ]
        },
        "ingest": {
          "anyOf": [{ "pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string" }, { "$ref": "#/$defs/Ingest" }]
        },
        "input": { "maxLength": 1024, "minLength": 1, "type": "string" },
        "keep": { "maximum": 1000, "minimum": 1, "type": "integer" },
        "lookback": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ]
        },
        "overlap": {
          "anyOf": [
            { "maximum": 315576000, "minimum": 0, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:0|(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+)$", "type": "string" }
          ]
        },
        "requires": {
          "items": { "maxLength": 256, "minLength": 1, "type": "string" },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "run": { "$ref": "#/$defs/Argv" },
        "timeout": {
          "anyOf": [
            { "maximum": 86400, "minimum": 1, "type": "integer" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ]
        },
        "timezone": { "maxLength": 128, "minLength": 1, "type": "string" }
      },
      "title": "Job",
      "type": "object"
    },
    "Server": {
      "additionalProperties": false,
      "properties": {
        "emit": { "enum": ["none", "events"], "type": "string" },
        "enabled": { "type": "boolean" },
        "env": {
          "additionalProperties": { "maxLength": 4096, "type": "string" },
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "type": "object"
        },
        "requires": {
          "items": { "maxLength": 256, "minLength": 1, "type": "string" },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "run": { "$ref": "#/$defs/Argv" }
      },
      "required": ["run"],
      "title": "Server",
      "type": "object"
    }
  },
  "$id": "https://fmind.github.io/brain-framework/bf.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Brain Framework configuration and orchestration (bf.yaml).",
  "properties": {
    "brains": {
      "additionalProperties": { "maxLength": 4096, "minLength": 1, "type": "string" },
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "channels": {
      "additionalProperties": { "$ref": "#/$defs/Channel" },
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "defaults": {
      "additionalProperties": false,
      "properties": {
        "env": {
          "additionalProperties": { "maxLength": 4096, "type": "string" },
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "type": "object"
        },
        "timezone": { "maxLength": 128, "minLength": 1, "type": "string" }
      },
      "type": ["object", "null"]
    },
    "jobs": {
      "additionalProperties": { "$ref": "#/$defs/Job" },
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "name": {
      "description": "Stable lowercase identifier for this brain.",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "servers": {
      "additionalProperties": { "$ref": "#/$defs/Server" },
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "type": ["object", "null"]
    },
    "version": { "const": 12, "description": "Brain configuration format version.", "type": "integer" },
    "watch": {
      "additionalProperties": false,
      "properties": {
        "debounce": {
          "anyOf": [
            { "maximum": 60, "minimum": 0.05, "type": "number" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ]
        },
        "interval": {
          "anyOf": [
            { "maximum": 3600, "minimum": 0.5, "type": "number" },
            { "maxLength": 32, "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d|w|y))+$", "type": "string" }
          ]
        }
      },
      "type": ["object", "null"]
    }
  },
  "required": ["version", "name"],
  "title": "Config",
  "type": "object"
}
