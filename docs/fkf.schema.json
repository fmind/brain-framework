{
  "$defs": {
    "Source": {
      "additionalProperties": false,
      "description": "Only execution configuration: adapters own provider-specific projection.",
      "properties": {
        "command": {
          "items": { "type": "string" },
          "maxItems": 128,
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "enabled": { "default": true, "title": "Enabled", "type": "boolean" },
        "lookback": { "default": 86400, "maximum": 31536000, "minimum": 1, "title": "Lookback", "type": "integer" },
        "max_bytes": {
          "default": 16777216,
          "maximum": 16777216,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "mode": { "default": "window", "enum": ["window", "snapshot"], "title": "Mode", "type": "string" },
        "overlap": { "default": 300, "maximum": 31536000, "minimum": 0, "title": "Overlap", "type": "integer" },
        "refresh": { "default": 0, "maximum": 31536000, "minimum": 0, "title": "Refresh", "type": "integer" },
        "timeout": { "default": 120, "maximum": 3600, "minimum": 1, "title": "Timeout", "type": "integer" }
      },
      "required": ["command"],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One base configuration with an optional machine-local source overlay.",
  "properties": {
    "id": { "pattern": "^[0-9a-f]{32}$", "title": "Id", "type": "string" },
    "name": { "pattern": "^[a-z][a-z0-9-]{0,63}$", "title": "Name", "type": "string" },
    "sources": {
      "patternProperties": { "^[a-z][a-z0-9-]{0,63}$": { "$ref": "#/$defs/Source" } },
      "title": "Sources",
      "type": "object"
    },
    "version": { "const": 1, "default": 1, "title": "Version", "type": "integer" }
  },
  "required": ["id", "name"],
  "title": "Config",
  "type": "object"
}
