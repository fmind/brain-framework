{
  "$defs": {
    "Heading": {
      "additionalProperties": false,
      "properties": {
        "id": { "maxLength": 256, "minLength": 1, "type": "string" },
        "level": { "maximum": 6, "minimum": 1, "type": "integer" },
        "meta": { "$ref": "#/$defs/Meta" },
        "title": { "maxLength": 4096, "type": "string" }
      },
      "required": ["id", "title", "level"],
      "title": "Heading",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "anchor": { "maxLength": 2048, "type": "string" },
        "kind": { "enum": ["note", "record", "brain", "url"], "type": "string" },
        "meta": { "$ref": "#/$defs/Meta" },
        "section": { "maxLength": 256, "type": "string" },
        "to": {
          "description": "Universal ref: note path, source:id, bf://<brain>/<ref>, or URL.",
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["to", "kind"],
      "title": "Link",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": { "maxLength": 4096, "type": "string" },
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
      "title": "Meta",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "done": { "type": "boolean" },
        "meta": { "$ref": "#/$defs/Meta" },
        "section": { "maxLength": 256, "type": "string" },
        "text": { "maxLength": 4096, "minLength": 1, "type": "string" }
      },
      "required": ["text", "done"],
      "title": "Task",
      "type": "object"
    }
  },
  "$id": "https://fmind.github.io/brain-framework/record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Unified JSON record schema enforced natively on compiled notes and ingested records in memories/*.jsonl.",
  "if": { "properties": { "kind": { "const": "memory" } }, "required": ["kind"] },
  "properties": {
    "aliases": {
      "description": "Alternate identifiers resolved by bf read/review.",
      "items": { "maxLength": 1024, "minLength": 1, "type": "string" },
      "maxItems": 200,
      "type": "array"
    },
    "attributes": { "description": "Optional sensor-specific domain attributes.", "type": "object" },
    "created": {
      "description": "Creation or event ISO date/timestamp.",
      "minLength": 10,
      "pattern": "^[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|[12][0-9]))(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2}))?$",
      "type": "string"
    },
    "description": { "description": "Short description of the note or record.", "maxLength": 16384, "type": "string" },
    "entity": {
      "description": "Canonical entity URI or source:id alias.",
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "headings": {
      "description": "Compiled Markdown headings with optional attr_list meta.",
      "items": { "$ref": "#/$defs/Heading" },
      "type": "array"
    },
    "id": {
      "description": "Stable source-local record identifier (required for memory).",
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "ingested_at": {
      "description": "UTC ingestion timestamp.",
      "minLength": 10,
      "pattern": "^[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|[12][0-9]))(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2}))?$",
      "type": "string"
    },
    "kind": { "description": "Top-level record kind (note or memory).", "enum": ["note", "memory"], "type": "string" },
    "links": {
      "description": "Normalized outgoing links.",
      "items": { "$ref": "#/$defs/Link" },
      "maxItems": 2000,
      "type": "array"
    },
    "ref": {
      "description": "Universal brain-local reference (note path or source:id).",
      "maxLength": 4200,
      "minLength": 1,
      "type": "string"
    },
    "sha256": {
      "description": "SHA-256 hex digest of source Markdown bytes.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source": {
      "description": "Owning source name (note dir or memories/<source>.jsonl).",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "stale_after": {
      "anyOf": [
        { "maxLength": 32, "pattern": "^(?:[0-9]+(?:s|m|h|d|w|y))+$", "type": "string" },
        {
          "minLength": 10,
          "pattern": "^[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|[12][0-9]))(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2}))?$",
          "type": "string"
        }
      ],
      "description": "Review freshness threshold (explicit duration like 90d or ISO date)."
    },
    "status": {
      "description": "Lifecycle status (e.g. draft, stable, active, open, done).",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "tags": {
      "description": "Unique tags without whitespace or slashes.",
      "items": { "maxLength": 128, "minLength": 1, "pattern": "^[^/\\\\\\s]+$", "type": "string" },
      "maxItems": 200,
      "type": "array",
      "uniqueItems": true
    },
    "tasks": {
      "description": "Compiled Markdown checklist tasks.",
      "items": { "$ref": "#/$defs/Task" },
      "type": "array"
    },
    "text": { "description": "Plain or Markdown body text.", "maxLength": 4194304, "type": "string" },
    "title": { "description": "Human-readable title.", "maxLength": 4096, "minLength": 1, "type": "string" },
    "type": {
      "description": "Domain subtype (e.g. guide, project, issue, usage).",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "updated": {
      "description": "Last-updated ISO date/timestamp.",
      "minLength": 10,
      "pattern": "^[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|[12][0-9]))(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2}))?$",
      "type": "string"
    },
    "url": {
      "description": "Canonical external URL (https, http, mailto, or urn).",
      "maxLength": 8192,
      "minLength": 1,
      "pattern": "^(?:https?://[^\\s/?#]+\\S*|(?:mailto|urn):\\S+)$",
      "type": "string"
    }
  },
  "required": ["ref", "source", "kind", "title"],
  "then": { "required": ["id"] },
  "title": "Record",
  "type": "object"
}
