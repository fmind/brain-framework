{
  "$defs": {
    "Registration": {
      "additionalProperties": false,
      "description": "A registered brain's location on this machine.",
      "properties": { "path": { "maxLength": 4096, "minLength": 1, "title": "Path", "type": "string" } },
      "required": ["path"],
      "title": "Registration",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Registered brains on this machine and the optional default selected outside a brain directory.",
  "properties": {
    "brains": {
      "anyOf": [
        {
          "additionalProperties": false,
          "patternProperties": { "^[a-z][a-z0-9-]{0,63}$": { "$ref": "#/$defs/Registration" } },
          "propertyNames": { "not": { "pattern": "[^a-z0-9-]" } },
          "type": "object"
        },
        { "type": "null" }
      ],
      "title": "Brains"
    },
    "default": {
      "anyOf": [
        { "not": { "pattern": "[^a-z0-9-]" }, "pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string" },
        { "type": "null" }
      ],
      "default": null,
      "title": "Default"
    }
  },
  "title": "UserConfig",
  "type": "object"
}
